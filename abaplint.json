{
  "global": { "files": "/src/**/*.*", "exclude": [] },
  "dependencies": [],
  "syntax": { "version": "v757", "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)" },
  "rules": {
    "parser_error": true,
    "xml_consistency": true,
    "check_syntax": true,
    "unknown_types": false,
    "check_ddic": true,
    "allowed_object_types": { "allowed": ["DEVC","DOMA","DTEL","TABL","PROG"] },
    "max_one_statement": true,
    "keyword_case": false
  }
}
